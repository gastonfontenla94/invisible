---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Discografía · Invisible · Directorio del Audio Argentino"
  descripcion="El trabajo, contado por quienes lo hicieron. Próximamente en Invisible."
  seccion="discografia"
>
  <section style="min-height:62vh; display:grid; place-items:center; text-align:center; padding:100px 0">
    <div class="contenedor">
      <h1 style="font-size:clamp(2.6rem,6vw,4rem)">Discografía</h1>
      <p style="margin-top:26px; font-size:1.15rem; color:var(--gris)">Próximamente.</p>
      <p style="margin-top:10px; font-family:var(--serif); font-size:1.25rem; color:var(--texto)">
        El trabajo, contado por quienes lo hicieron.
      </p>
    </div>
  </section>
</Base>
